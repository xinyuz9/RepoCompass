# Supported providers: deepseek, openai. DeepSeek remains the default when this
# variable is omitted for backward compatibility.
REPOCOMPASS_MODEL_PROVIDER=deepseek

# Shared model name and provider credential.
REPOCOMPASS_MODEL=deepseek-v4-flash
REPOCOMPASS_API_KEY=

# Required only by the DeepSeek adapter. The OpenAI adapter uses OpenAI's
# official endpoint and does not consume this variable.
REPOCOMPASS_BASE_URL=https://api.deepseek.com

# DeepSeek thinking remains disabled until multi-turn reasoning_content
# round-trip behavior is implemented and verified.

# Paid live tests are disabled unless this exact marker is changed to 1 for one
# explicit invocation. The CLI additionally requires --acknowledge-live-api-costs.
REPOCOMPASS_RUN_LIVE_TESTS=0

# Required only by tests/live/test_provider_smoke.py when the marker above is 1.
# Use a reviewed exact-model pricing snapshot, an explicit positive USD cap, and
# a new output path. Never commit credentials in this file.
REPOCOMPASS_LIVE_PRICING_FILE=examples/pricing.deepseek-2026-08-27.json
REPOCOMPASS_LIVE_MAX_COST_USD=0.002
REPOCOMPASS_LIVE_REPORT_FILE=.repocompass/live-provider-smoke.json

# Optional Remote LangSmith SaaS tracing. Keep disabled by default, especially for
# private repositories: traces may contain prompts, tool inputs/outputs, and source.
# This uses LangGraph/LangChain automatic tracing only and does not replace the
# local RepoCompass Domain Trace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repocompass-dev

# Optional for non-default LangSmith routing:
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=

# Optional: disable anonymous LangGraph CLI usage analytics during local Studio use.
LANGGRAPH_CLI_NO_ANALYTICS=1
